# Operator identity (not a secret). Clerk user with this email is the system user.
SYSTEM_USER_EMAIL=marcode.chavez.jr@gmail.com
# Alias: DATABSED_SYSTEM_EMAIL

# Clerk (never commit real values)
# Client publishable key — also accepted: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, VITE_CLERK_PUBLISHABLE_KEY
CLERK_PUBLISHABLE_KEY=
# Server only. Do not expose to the browser.
CLERK_SECRET_KEY=
# Clerk-owned Frontend API host (not *.vercel.app). Example: something.clerk.accounts.dev
# Required when pk_live_ / pk_test_ decodes to a Vercel satellite host.
# Also accepted: NEXT_PUBLIC_CLERK_FRONTEND_API, VITE_CLERK_FRONTEND_API
CLERK_FRONTEND_API=

# Public site origin for absolute Open Graph / Twitter image URLs at Vercel build.
# Example: PUBLIC_ORIGIN=https://your-deployment.vercel.app
# If unset, index.html keeps path-relative og:url (/) and og:image (/og.png).
# Those work once deployed; some crawlers still want the full origin.
PUBLIC_ORIGIN=

# Persistence (Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# or BLOB_READ_WRITE_TOKEN
# STORE_BACKEND=kv|blob|fs
